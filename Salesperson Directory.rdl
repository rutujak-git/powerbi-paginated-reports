  <DataSets>
    <DataSet Name="dsMain">
      <Query>
        <DataSourceName>AdventureWorksDW2019</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EmployeeKey">
            <Value>=Parameters!EmployeeKey.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SalesTerritoryGroup">
            <Value>=Parameters!SalesTerritoryGroup.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="DimEmployee" ColumnName="FirstName" />
              <ColumnExpression ColumnOwner="DimEmployee" ColumnName="LastName" />
              <ColumnExpression ColumnOwner="DimEmployee" ColumnName="Title" />
              <ColumnExpression ColumnOwner="DimEmployee" ColumnName="EmailAddress" />
              <ColumnExpression ColumnOwner="DimEmployee" ColumnName="Phone" />
              <ColumnExpression ColumnOwner="DimEmployee" ColumnName="EmployeePhoto" />
              <ColumnExpression ColumnOwner="DimSalesTerritory" ColumnName="SalesTerritoryRegion" />
              <ColumnExpression ColumnOwner="DimSalesTerritory" ColumnName="SalesTerritoryGroup" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="DimSalesTerritory" />
              <Join Type="INNER JOIN" ColumnOwner="DimEmployee">
                <On>
                  <From ColumnOwner="DimSalesTerritory" ColumnName="SalesTerritoryKey" />
                  <To ColumnOwner="DimEmployee" ColumnName="SalesTerritoryKey" />
                </On>
              </Join>
            </Joins>
            <Filters>
              <Filter Operator="=">
                <ColumnExpression ColumnOwner="DimEmployee" ColumnName="SalesPersonFlag" />
                <FilterValue>True</FilterValue>
              </Filter>
              <Filter Operator="=" Param="True">
                <ColumnExpression ColumnOwner="DimEmployee" ColumnName="EmployeeKey" />
              </Filter>
            </Filters>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
    DimEmployee.EmployeeKey
    ,DimEmployee.FirstName
    ,DimEmployee.LastName
    ,DimEmployee.Title
    ,DimEmployee.EmailAddress
    ,DimEmployee.Phone
    ,DimEmployee.EmployeePhoto
    ,DimSalesTerritory.SalesTerritoryRegion
    ,DimSalesTerritory.SalesTerritoryGroup
FROM
    DimSalesTerritory
    INNER JOIN DimEmployee
        ON DimSalesTerritory.SalesTerritoryKey = DimEmployee.SalesTerritoryKey
WHERE
    DimEmployee.SalesPersonFlag = N'True'
    AND (DimEmployee.EmployeeKey IN (@EmployeeKey ))
    AND DimSalesTerritory.SalesTerritoryGroup = @SalesTerritoryGroup</CommandText>
      </Query>
      <Fields>
        <Field Name="Salesperson">
          <Value>=StrConv(Fields!FirstName.Value, vbProperCase) &amp; " " &amp; StrConv(Fields!LastName.Value, vbProperCase)</Value>
        </Field>
        <Field Name="EmployeeKey">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>EmployeeKey</DataField>
        </Field>
        <Field Name="GroupRegion">
          <Value>=Fields!SalesTerritoryGroup.Value &amp; ":" &amp; Fields!SalesTerritoryRegion.Value</Value>
        </Field>
        <Field Name="FirstName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>FirstName</DataField>
        </Field>
        <Field Name="LastName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>LastName</DataField>
        </Field>
        <Field Name="Title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Title</DataField>
        </Field>
        <Field Name="EmailAddress">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>EmailAddress</DataField>
        </Field>
        <Field Name="Phone">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Phone</DataField>
        </Field>
        <Field Name="EmployeePhoto">
          <rd:TypeName>System.Byte[]</rd:TypeName>
          <DataField>EmployeePhoto</DataField>
        </Field>
        <Field Name="SalesTerritoryRegion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SalesTerritoryRegion</DataField>
        </Field>
        <Field Name="SalesTerritoryGroup">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SalesTerritoryGroup</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSalesPerson">
      <Query>
        <DataSourceName>AdventureWorksDW2019</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@SalesTerritoryGroup">
            <Value>=Parameters!SalesTerritoryGroup.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    [e].[EmployeeKey]
    ,[e].[FirstName] + N' ' + [e].[LastName] AS [SalespersonName]
FROM
    [dbo].[DimEmployee] AS [e]
    INNER JOIN [dbo].[DimSalesTerritory] AS [st]
        ON [st].[SalesTerritoryKey] = [e].[SalesTerritoryKey]
WHERE
    [e].[SalesPersonFlag] = 1
    AND [st].[SalesTerritoryGroup] = @SalesTerritoryGroup
ORDER BY
    [SalespersonName];</CommandText>
      </Query>
      <Fields>
        <Field Name="EmployeeKey">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>EmployeeKey</DataField>
        </Field>
        <Field Name="SalespersonName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SalespersonName</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSalesTerritoryGroups">
      <Query>
        <DataSourceName>AdventureWorksDW2019</DataSourceName>
        <CommandText>SELECT DISTINCT
    [SalesTerritoryGroup]
FROM
    [dbo].[DimSalesTerritory]
ORDER BY
    [SalesTerritoryGroup];</CommandText>
      </Query>
      <Fields>
        <Field Name="SalesTerritoryGroup">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SalesTerritoryGroup</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
