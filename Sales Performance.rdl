              <Calculations />
              <Aggregates />
              <QueryProperties>
                <IncludeMemberValue>true</IncludeMemberValue>
              </QueryProperties>
            </QuerySpecification>
            <Query>
              <Statement> SELECT NON EMPTY { [Measures].[total_new_confirmed], [Measures].[case_fatality_rate], [Measures].[full_vaccination_rate_pct], [Measures].[7day_avg_new_confirmed], [Measures].[Vaccination Rate %] } ON COLUMNS, NON EMPTY { ([dimlocation].[CountryName].[CountryName].ALLMEMBERS * [dimdate].[Year].[Year].ALLMEMBERS * [dimdate].[Month].[Month].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_VALUE, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( STRTOSET(@dimdateYear, CONSTRAINED) ) ON COLUMNS FROM [Model]) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</Statement>
              <ParameterDefinitions>
                <ParameterDefinition>
                  <Name>dimdateYear</Name>
                  <DefaultValues>
                    <DefaultValue>[dimdate].[Year].&amp;[2020]</DefaultValue>
                    <DefaultValue>[dimdate].[Year].&amp;[2021]</DefaultValue>
                    <DefaultValue>[dimdate].[Year].&amp;[2022]</DefaultValue>
                  </DefaultValues>
                  <Caption>Year</Caption>
                  <HierarchyUniqueName>[dimdate].[Year]</HierarchyUniqueName>
                  <ParameterValuesQuery>
                    <Statement>WITH MEMBER [Measures].[ParameterCaption] AS [dimdate].[Year].CURRENTMEMBER.MEMBER_CAPTION MEMBER [Measures].[ParameterValue] AS [dimdate].[Year].CURRENTMEMBER.UNIQUENAME MEMBER [Measures].[ParameterLevel] AS [dimdate].[Year].CURRENTMEMBER.LEVEL.ORDINAL SELECT {[Measures].[ParameterCaption], [Measures].[ParameterValue], [Measures].[ParameterLevel]} ON COLUMNS , [dimdate].[Year].ALLMEMBERS ON ROWS FROM [Model]</Statement>
                    <ParameterizedStatement>
                      <ReferencedParameters />
                    </ParameterizedStatement>
                  </ParameterValuesQuery>
                  <MultipleValues>true</MultipleValues>
                </ParameterDefinition>
              </ParameterDefinitions>
            </Query>
