              <From>Model</From>
              <Filter>
                <FilterItems>
                  <FilterItem>
                    <HierarchyUniqueName>[dimdate].[Year]</HierarchyUniqueName>
                    <Condition xsi:type="EqualTo">
                      <Members>
                        <Member>
                          <MemberUniqueName>[dimdate].[Year].&amp;[2020]</MemberUniqueName>
                        </Member>
                        <Member>
                          <MemberUniqueName>[dimdate].[Year].&amp;[2021]</MemberUniqueName>
                        </Member>
                        <Member>
                          <MemberUniqueName>[dimdate].[Year].&amp;[2022]</MemberUniqueName>
                        </Member>
                      </Members>
